{
  "name": "cauldron-workbench",
  "version": "0.1.0",
  "description": "造化乾坤鼎 DSH 原生工作台：结构化阅读生态，不替代对话。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./web/app.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "src",
    "web",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check web/app.js && node --check src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
