{
  "name": "cauldron-workbench",
  "version": "0.3.4",
  "description": "造化乾坤鼎 DSH 原生工作台：只读查看引擎 / 产品 / 组合的三级生态快照。",
  "type": "module",
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "src",
    "web",
    "cordis.patch.yml",
    "README.md",
    "web-neural/dist"
  ],
  "scripts": {
    "check": "node --check dsh/index.mjs && node --check lib/client.js && node --check src/snapshot.mjs && node --check server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
